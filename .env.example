# Copy to .env and fill in to run live (otherwise everything runs in safe dry-run).

# --- PayPal Payouts (fiat leg) ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# --- PYUSD on-chain (stablecoin leg) ---
PYUSD_NETWORK=sepolia
PYUSD_RPC_URL=
PYUSD_PRIVATE_KEY=
PYUSD_TOKEN_ADDRESS=

# --- Live fiat payouts: default receiver (your sandbox PERSONAL account email) ---
PAYPAL_SB_RECEIVER=

# --- LLM routing judgment (OPTIONAL; ambiguous cases only) ---
# Use YOUR OWN hackathon key here — never a shared or Claude Code account.
# Unset -> the deterministic router decides everything (no LLM call, no billing).
# Requires: npm i @anthropic-ai/sdk
ANTHROPIC_API_KEY=
PYLOT_LLM_MODEL=claude-opus-4-8

# --- Pylot runtime ---
PYLOT_LIVE=0          # set 1 to let the MCP pay_batch tool execute for real
PYLOT_LEDGER=ledger.jsonl
